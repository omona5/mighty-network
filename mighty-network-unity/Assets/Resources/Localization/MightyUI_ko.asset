  - m_Id: 7262043247714393
    m_Localized: "\uB2F9\uC2E0\uC774 \uC774\uBC88 \uD2B8\uB9AD\uC744 \uC774\uACA8
      \uC810\uC218 \uCE74\uB4DC 5\uC7A5\uC744 \uAC00\uC838\uAC14\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7262043247714394
    m_Localized: "\uBD07\uC774 \uC774\uBC88 \uD2B8\uB9AD\uC744 \uC774\uACA8 \uC810\uC218
      \uCE74\uB4DC 5\uC7A5\uC744 \uAC00\uC838\uAC14\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7630984121917440
    m_Localized: "\uB9C8\uC774\uD2F0\uB85C \uD2B8\uB9AD \uC2B9\uB9AC"
    m_Metadata:
      m_Items: []
  - m_Id: 7630984168054784
    m_Localized: "\u2660A\uAC00 \uAC00\uC7A5 \uAC15\uD558\uBBC0\uB85C \uB2F9\uC2E0\uC774
      \uC774 \uD2B8\uB9AD\uC744 \uC774\uACBC\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7630984168054785
    m_Localized: "\uCD5C\uC18C\uD654"
    m_Metadata:
      m_Items: []
  - m_Id: 7630984168054786
    m_Localized: "\uD3BC\uCE58\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 7630984168054787
    m_Localized: "\uD2B8\uB9AD\uC744 \uC774\uAE34 \uC0AC\uB78C\uC774 \uB2E4\uC74C
      \uD2B8\uB9AD\uC744 \uC2DC\uC791\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7647835623235584
    m_Localized: "\uB9C8\uC774\uD2F0\uC5D0\uB294 \uC138 \uAC00\uC9C0 \uC5ED\uD560\uC774
      \uC788\uC2B5\uB2C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 7647835648401408
    m_Localized: "\uB9C8\uC774\uD2F0\uC5D0\uB294 \uC8FC\uACF5, \uD504\uB80C\uB4DC,
      \uC2DC\uBBFC\uC774\uB77C\uB294 \uC138 \uAC00\uC9C0 \uC5ED\uD560\uC774 \uC788\uC2B5\uB2C8\uB2E4.\n\n\uC8FC\uACF5\uC740
      \uC774\uBC88 \uAC8C\uC784\uC744 \uC774\uB04C\uBA70, \uD2B9\uC815 \uC810\uC218
      \uC774\uC0C1 \uD68D\uB4DD\uC744 \uBAA9\uD45C\uB85C \uACF5\uC57D\uD574 \uB2F9\uC120\uB41C
      \uD50C\uB808\uC774\uC5B4\uC785\uB2C8\uB2E4. \uAC15\uD55C \uC190\uD328\uB97C
      \uD65C\uC6A9\uD574 \uD504\uB80C\uB4DC\uC640 \uD568\uAED8 \uBAA9\uD45C \uC810\uC218\uB97C
      \uB2EC\uC131\uD574\uC57C \uC2B9\uB9AC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7647835648401409
    m_Localized: "\uD504\uB80C\uB4DC \xB7 \uC228\uACA8\uC9C4 \uAC19\uC740 \uD300"
    m_Metadata:
      m_Items: []
  - m_Id: 7647835648401410
    m_Localized: "\uD504\uB80C\uB4DC\uB294 \uC8FC\uACF5\uC774 \uC120\uD0DD\uD55C
      \uC228\uACA8\uC9C4 \uC8FC\uACF5\uD300\uC758 \uC77C\uC6D0\uC785\uB2C8\uB2E4.
      \uD504\uB80C\uB4DC \uCE74\uB4DC(\uC608: \uB9C8\uC774\uD2F0)\uB97C \uB0B4\uAE30
      \uC804\uAE4C\uC9C0\uB294 \uC8FC\uACF5\uC744 \uD3EC\uD568\uD55C \uB2E4\uB978
      \uD50C\uB808\uC774\uC5B4\uC5D0\uAC8C \uC815\uCCB4\uAC00 \uACF5\uAC1C\uB418\uC9C0
      \uC54A\uC2B5\uB2C8\uB2E4.\n\n\uD504\uB80C\uB4DC\uB294 \uC790\uC2E0\uC758 \uC5ED\uD560\uC744
      \uC54C\uACE0 \uC788\uC73C\uBA70, \uC2DC\uBBFC\uB4E4 \uC0AC\uC774\uC5D0 \uC228\uC5B4
      \uC8FC\uACF5\uC744 \uB3C4\uC640\uC57C \uD569\uB2C8\uB2E4. \uACF5\uAC1C\uB418\uBA74
      \uC774\uC804\uC5D0 \uBAA8\uC740 \uC810\uC218\uAE4C\uC9C0 \uC8FC\uACF5\uD300
      \uC810\uC218\uC5D0 \uD569\uC0B0\uB429\uB2C8\uB2E4. \uC8FC\uACF5\uD300\uC774
      \uBAA9\uD45C \uC810\uC218\uB97C \uB2EC\uC131\uD558\uBA74 \uD568\uAED8 \uC2B9\uB9AC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7647835648401411
    m_Localized: "\uC2DC\uBBFC \xB7 \uC8FC\uACF5\uD300\uC758 \uBAA9\uD45C\uB97C \uB9C9\uC73C\uC138\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 7647835648401412
    m_Localized: "\uC2DC\uBBFC\uC740 \uC8FC\uACF5\uACFC \uD504\uB80C\uB4DC\uAC00
      \uC544\uB2CC \uB098\uBA38\uC9C0 \uC138 \uBA85\uC758 \uD50C\uB808\uC774\uC5B4\uC785\uB2C8\uB2E4.\n\n\uC8FC\uACF5\uD300(\uC8FC\uACF5
      + \uD504\uB80C\uB4DC)\uC774 \uBAA9\uD45C \uC810\uC218\uB97C \uB2EC\uC131\uD558\uC9C0
      \uBABB\uD558\uB3C4\uB85D \uC810\uC218 \uCE74\uB4DC\uB97C \uAC00\uC838\uC640\uC57C
      \uD569\uB2C8\uB2E4. \uD654\uBA74\uC5D0\uC11C\uB294 \uC2DC\uBBFC \uD300\uC744
      \uC218\uBE44\uD300\uC774\uB77C\uACE0\uB3C4 \uBD80\uB985\uB2C8\uB2E4.\n\n\uC774\uBC88
      \uC5F0\uC2B5\uC5D0\uC11C\uB294 \uC9C1\uC811 \uC8FC\uACF5\uC774 \uB418\uC5B4,
      \uC228\uACA8\uC9C4 \uD504\uB80C\uB4DC\uC640 \uD568\uAED8 \uD50C\uB808\uC774\uD574
      \uBD05\uC2DC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7647835648401413
    m_Localized: "\u2665Q\uB85C \uB2E4\uC74C \uD2B8\uB9AD \uC2DC\uC791"
    m_Metadata:
      m_Items: []
  - m_Id: 7647835648401414
    m_Localized: "\uC55E \uD2B8\uB9AD\uC744 \uC774\uACBC\uC73C\uBBC0\uB85C \uB2E4\uC2DC
      \uB0B4\uAC00 \uBA3C\uC800 \uB0C5\uB2C8\uB2E4.\n\n\u2665Q\uB97C \uB0B4\uBCF4\uC138\uC694.
      \uB2E4\uB978 \uD50C\uB808\uC774\uC5B4\uC5D0\uAC8C \uC788\uB294 \u2665K\uB294
      \u2665Q\uBCF4\uB2E4 \uAC15\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7647835648401415
    m_Localized: "\u2665Q\uB97C \uB0B4\uC11C \uB2E4\uC74C \uD2B8\uB9AD\uC744 \uC2DC\uC791\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 7647835648401416
    m_Localized: "\uC2DC\uBBFC\uC758 \u2665K\uAC00 \uC55E\uC11C\uACE0 \uC788\uC2B5\uB2C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 7647835648401417
    m_Localized: "\uC2DC\uBBFC\uC774 \u2665K\uB97C \uB0B4\uC11C \u2665Q\uB97C \uC55E\uC130\uC2B5\uB2C8\uB2E4.
      \uC9C0\uAE08 \uD2B8\uB9AD\uC774 \uB05D\uB098\uBA74 \uC810\uC218\uB97C \uC2DC\uBBFC
      \uD300\uC5D0\uAC8C \uBE7C\uC557\uAE41\uB2C8\uB2E4.\n\n\uC544\uC9C1 \uB9C8\uC9C0\uB9C9
      \uD50C\uB808\uC774\uC5B4\uAC00 \uCE74\uB4DC\uB97C \uB0B4\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4.
      \uD655\uC778\uC744 \uB20C\uB7EC \uB9C8\uC9C0\uB9C9 \uCE74\uB4DC\uB97C \uC0B4\uD3B4\uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 7647835648401418
    m_Localized: "\uCCAB \uBC88\uC9F8 \uC5F0\uC2B5 \uD310\uC744 \uC900\uBE44\uC911\uC785\uB2C8\uB2E4..."
    m_Metadata:
      m_Items: []
  - m_Id: 7647835648401419
    m_Localized: "\uB450 \uBC88\uC9F8 \uC5F0\uC2B5 \uD310\uC744 \uC900\uBE44\uC911\uC785\uB2C8\uB2E4..."
    m_Metadata:
      m_Items: []
  - m_Id: 7647835648401420
    m_Localized: "\uC774\uBC88\uC5D0\uB294 \u2665Q\uB97C \uB0B4\uC11C \uC228\uACA8\uC9C4
      \uD504\uB80C\uB4DC\uAC00 \uC5B4\uB5BB\uAC8C \uB3C4\uC640\uC8FC\uB294\uC9C0
      \uC0B4\uD3B4\uBD05\uC2DC\uB2E4."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
