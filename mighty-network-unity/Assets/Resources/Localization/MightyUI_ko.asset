  - m_Id: 1471020537978881
    m_Localized: "\uC74C\uC18C\uAC70"
    m_Metadata:
      m_Items: []
  - m_Id: 2567876202438656
    m_Localized: "\uBC84\uB9B4 \uCE74\uB4DC 3\uC7A5\uC744 \uACE0\uB974\uC138\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 2567876256964608
    m_Localized: "{0}\uC744 \uD504\uB80C\uB4DC\uB85C \uC120\uC5B8\uD558\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 2567876256964609
    m_Localized: "\uB178\uD504\uB80C\uB4DC\uB85C \uC120\uC5B8\uD558\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 2567876256964610
    m_Localized: "\uB124"
    m_Metadata:
      m_Items: []
  - m_Id: 2567876256964611
    m_Localized: "\uC544\uB2C8\uC624"
    m_Metadata:
      m_Items: []
  - m_Id: 4321347998031872
    m_Localized: "\uC900\uBE44 \uCDE8\uC18C"
    m_Metadata:
      m_Items: []
  - m_Id: 4690287722995712
    m_Localized: " (\uBC84\uB9B0\uD328 {0})"
    m_Metadata:
      m_Items: []
  - m_Id: 4690287752355840
    m_Localized: "\uBC84\uB9B0\uD328 {0}\uC810 (\uC8FC\uACF5\uD300 \uD569\uACC4\uC5D0
      \uD3EC\uD568)"
    m_Metadata:
      m_Items: []
  - m_Id: 4690287752355841
    m_Localized: " / \uB0A8\uC740 "
    m_Metadata:
      m_Items: []
  - m_Id: 4690287752355842
    m_Localized: "\uC5B4\uB5A4 \uCE74\uB4DC\uAC00 \uB354 \uAC15\uD560\uAE4C\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 4690287752355843
    m_Localized: "\uAE30\uBCF8 \uC21C\uC11C: \uB9C8\uC774\uD2F0 > \uC870\uCEE4 >
      \uAE30\uB8E8\uB2E4 > \uCCAB \uCE74\uB4DC\uC758 \uBB34\uB2AC\n\n\uAC19\uC740
      \uBB34\uB2AC\uC5D0\uC11C\uB294 A > K > Q > J > 10 > 9 > \u2026 > 2 \uC21C\uC11C\uB85C
      \uAC15\uD569\uB2C8\uB2E4. \uAE30\uB8E8\uB2E4\uAC00 \uC544\uB2CC \uB2E4\uB978
      \uBB34\uB2AC\uB294 \uC22B\uC790\uAC00 \uB192\uC544\uB3C4 \uCCAB \uCE74\uB4DC\uC758
      \uBB34\uB2AC\uB97C \uC774\uAE38 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.\n\n\uC774\uBC88
      \uD310\uC758 \uAE30\uB8E8\uB2E4\uB294 \uD558\uD2B8\uC785\uB2C8\uB2E4. \uB9C8\uC774\uD2F0\uB294
      \uC5B8\uC81C\uB098 \uAC00\uC7A5 \uAC15\uD558\uACE0, \uC870\uCEE4\uB294 \uCCAB\xB7\uB9C8\uC9C0\uB9C9
      \uD2B8\uB9AD\uACFC \uC870\uCEE4\uCF5C\uC5D0\uC11C \uD798\uC744 \uC783\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 6909019002216448
    m_Localized: "\uBC29 \uCC38\uC5EC"
    m_Metadata:
      m_Items: []
  - m_Id: 6909019056742400
    m_Localized: "\uCC38\uC5EC\uD560 \uBC29 \uCF54\uB4DC\uB97C \uC785\uB825\uD558\uC138\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 6909019056742401
    m_Localized: "\uCD08\uB300 \uB9C1\uD06C \uBCF5\uC0AC"
    m_Metadata:
      m_Items: []
  - m_Id: 6909019056742402
    m_Localized: "\uCD08\uB300\uBC1B\uC740 \uBC29: "
    m_Metadata:
      m_Items: []
  - m_Id: 6909019056742403
    m_Localized: "\uD504\uB80C\uB4DC\uB97C \uC120\uD0DD\uD558\uC138\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 6909019056742404
    m_Localized: "\uB2C9\uB124\uC784\uC744 \uC785\uB825\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 6909019056742405
    m_Localized: "\uBC29 \uCF54\uB4DC\uB97C \uC785\uB825\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 6909019056742406
    m_Localized: "\uCD08\uB300 \uB9C1\uD06C\uB97C \uBCF5\uC0AC\uD588\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 6909019056742407
    m_Localized: "\uBCF5\uC0AC\uD558\uC9C0 \uBABB\uD588\uC2B5\uB2C8\uB2E4. \uBE0C\uB77C\uC6B0\uC800
      \uC8FC\uC18C\uCC3D\uC758 \uB9C1\uD06C\uB97C \uBCF5\uC0AC\uD574 \uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 6909019056742408
    m_Localized: "\uCD08\uB300 \uB9C1\uD06C \uBCF5\uC0AC \uC911..."
    m_Metadata:
      m_Items: []
  - m_Id: 6909019056742409
    m_Localized: "\uB2C9\uB124\uC784\uC744 \uC785\uB825\uD558\uC138\uC694. (1~12\uC790)"
    m_Metadata:
      m_Items: []
  - m_Id: 6909019056742410
    m_Localized: "\uBC29 \uCF54\uB4DC\uB294 \uC601\uBB38\xB7\uC22B\uC790 4\uC790\uB9AC\uB85C
      \uC785\uB825\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 6909019056742411
    m_Localized: "\uBC29 \uBE44\uBC00\uBC88\uD638\uAC00 \uD2C0\uB838\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 6909019056742412
    m_Localized: "\uC774\uBBF8 \uC2DC\uC791\uB41C \uBC29\uC5D0\uB294 \uC785\uC7A5\uD560
      \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 6909019056742413
    m_Localized: "\uBC29\uC774 \uAC00\uB4DD \uCC3C\uC2B5\uB2C8\uB2E4. (\uC0AC\uB78C
      5\uBA85)"
    m_Metadata:
      m_Items: []
  - m_Id: 6909019056742414
    m_Localized: "\uBC29\uC744 \uCC3E\uC744 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4: "
    m_Metadata:
      m_Items: []
  - m_Id: 6909019056742415
    m_Localized: "\uAC8C\uC784 \uC2DC\uC791 \uC548\uB0B4\uAC00 \uB05D\uB09C \uB4A4
      \uCE74\uB4DC\uB97C \uB0BC \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 6909019056742416
    m_Localized: "\uB2F9\uC120 \uC548\uB0B4\uAC00 \uB05D\uB09C \uB4A4 \uCE74\uB4DC\uB97C
      \uBC84\uB9B4 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 6909019056742417
    m_Localized: "3\uC7A5 \uBC84\uB9AC\uAE30 ("
    m_Metadata:
      m_Items: []
  - m_Id: 6909462298206208
    m_Localized: "\uD655\uC778"
    m_Metadata:
      m_Items: []
  - m_Id: 7134920700829696
    m_Localized: "\uC2DC\uC791 \uC804, \uB124 \uAC00\uC9C0 \uC6A9\uC5B4"
    m_Metadata:
      m_Items: []
  - m_Id: 7134920772132864
    m_Localized: "\uC8FC\uACF5: \uC785\uCC30\uC5D0\uC11C \uB2F9\uC120\uB41C \uC0AC\uB78C\uC785\uB2C8\uB2E4.
      \uAE30\uB8E8\uB2E4\uC640 \uBAA9\uD45C \uC810\uC218(\uACF5\uC57D)\uB97C \uC815\uD558\uACE0,
      \uD568\uAED8\uD560 \uD504\uB80C\uB4DC\uB97C \uC120\uD0DD\uD569\uB2C8\uB2E4.\n\n\uD504\uB80C\uB4DC:
      \uC8FC\uACF5\uACFC \uAC19\uC740 \uD300\uC778 \uC0AC\uB78C\uC785\uB2C8\uB2E4.
      \uD2B9\uC815 \uCE74\uB4DC\uB97C \uC9C0\uC815\uD558\uBA74 \uADF8 \uCE74\uB4DC\uB97C
      \uAC00\uC9C4 \uC0AC\uB78C\uC774 \uD504\uB80C\uB4DC\uC774\uBA70, \uCE74\uB4DC\uB97C
      \uB0B4\uBA74 \uC815\uCCB4\uAC00 \uACF5\uAC1C\uB429\uB2C8\uB2E4.\n\n\uB9C8\uC774\uD2F0:
      \uAC00\uC7A5 \uAC15\uD55C \uCE74\uB4DC\uC785\uB2C8\uB2E4. \uBCF4\uD1B5 \u2660A\uC774\uACE0,
      \uC2A4\uD398\uC774\uB4DC\uAC00 \uAE30\uB8E8\uB2E4\uC77C \uB54C\uB294 \u2666A\uC785\uB2C8\uB2E4.\n\n\uAE30\uB8E8\uB2E4:
      \uC774\uBC88 \uD310\uC758 \uC73C\uB738 \uBB34\uB2AC\uC785\uB2C8\uB2E4. \uB9C8\uC774\uD2F0\xB7\uC870\uCEE4\uB97C
      \uC81C\uC678\uD55C \uB2E4\uB978 \uBB34\uB2AC\uC758 \uCE74\uB4DC\uBCF4\uB2E4
      \uAC15\uD569\uB2C8\uB2E4. \uB178\uAE30\uB8E8\uC5D0\uC11C\uB294 \uC73C\uB738
      \uBB34\uB2AC\uAC00 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7134920772132865
    m_Localized: "\uD558\uD2B8\uAC00 \uB9CE\uC774 \uB4E4\uC5B4\uC628 \uAC15\uD55C
      \uD328\uC785\uB2C8\uB2E4. \uC774\uBC88\uC5D0\uB294 \uC9C1\uC811 \uC8FC\uACF5\uC774
      \uB418\uC5B4 \uC6B0\uB9AC \uD300\uC758 \uBAA9\uD45C \uC810\uC218\uC640 \uAE30\uB8E8\uB2E4\uB97C
      \uC815\uD574 \uBD05\uC2DC\uB2E4.\n\n13\uC810\uACFC \uD558\uD2B8\uB97C \uC120\uD0DD\uD55C
      \uB4A4 \uACF5\uC57D\uC744 \uC81C\uCD9C\uD558\uC138\uC694. \uC774 \uC5F0\uC2B5\uC5D0\uC11C\uB294
      \uBD07\uB4E4\uC774 \uBAA8\uB450 \uD328\uC2A4\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7134920772132866
    m_Localized: "\uC774\uBC88 \uD310\uC758 \uC8FC\uACF5\uC740 \uBD07\uC774\uACE0,
      \uACF5\uC57D\uC740 \uD558\uD2B8 \uAE30\uB8E8\uB2E4\xB713\uC810\uC785\uB2C8\uB2E4.\n\n\uC8FC\uACF5\uC774
      \uD504\uB80C\uB4DC \uCE74\uB4DC\uB85C \u2660A\uB97C \uC9C0\uC815\uD588\uC2B5\uB2C8\uB2E4.
      \uADF8 \uCE74\uB4DC\uB97C \uAC00\uC9C4 \uB2F9\uC2E0\uC774 \uAC19\uC740 \uD300\uC785\uB2C8\uB2E4.
      \u2660A\uB97C \uB0B4\uBA74 \uB2E4\uB978 \uC0AC\uB78C\uB4E4\uC5D0\uAC8C\uB3C4
      \uC815\uCCB4\uAC00 \uACF5\uAC1C\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7262043226742784
    m_Localized: "1 / 2 \xB7 \uD50C\uB808\uC774 \uD574\uBCF4\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 7262043247714304
    m_Localized: "\uD654\uBA74 \uC544\uB798\uC758 \uC55E\uBA74 \uCE74\uB4DC 10\uC7A5\uC774
      \uB0B4 \uC190\uD328\uC785\uB2C8\uB2E4. \uB2E4\uB978 \uB124 \uC0AC\uB78C\uC758
      \uC190\uD328\uB294 \uB4B7\uBA74\uC73C\uB85C \uBCF4\uC785\uB2C8\uB2E4.\n\n\uC774\uBC88\uC5D0\uB294
      \uCE74\uB4DC\uB97C \uC9C1\uC811 \uB0B4\uBA74\uC11C \uADDC\uCE59\uC744 \uBC30\uC6CC\uBD05\uC2DC\uB2E4.
      \uC124\uBA85\uC744 \uC77D\uACE0 \uD655\uC778\uC744 \uB204\uB974\uBA74 \uC5F0\uC2B5\uC774
      \uC9C4\uD589\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7262043247714305
    m_Localized: "\uCCAB \uCE74\uB4DC\uC758 \uBB34\uB2AC"
    m_Metadata:
      m_Items: []
  - m_Id: 7262043247714306
    m_Localized: "\uC774\uBC88 \uD2B8\uB9AD\uC740 \uC120 \uD50C\uB808\uC774\uC5B4\uAC00
      \u2663A\uB85C \uC2DC\uC791\uD588\uC2B5\uB2C8\uB2E4. \uCCAB \uCE74\uB4DC\uC640
      \uAC19\uC740 \uBB34\uB2AC\uAC00 \uC190\uC5D0 \uC788\uC73C\uBA74 \uC77C\uBC18
      \uCE74\uB4DC\uB294 \uADF8 \uBB34\uB2AC\uB97C \uB530\uB77C \uB0B4\uC57C \uD569\uB2C8\uB2E4.\n\n\uBC14\uB2E5\uC5D0
      \uCE74\uB4DC\uAC00 2\uC7A5 \uC774\uC0C1 \uB193\uC774\uBA74 \uD604\uC7AC \uAC00\uC7A5
      \uAC15\uD55C \uCE74\uB4DC\uC5D0 \uB178\uB780\uC0C9 \uD14C\uB450\uB9AC\uAC00
      \uD45C\uC2DC\uB429\uB2C8\uB2E4.\n\n\uC774\uBC88\uC5D0\uB294 \u26632\uB97C \uB0B4\uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 7262043247714307
    m_Localized: "\u26632\uB97C \uB0B4\uC11C \uD074\uB85C\uBC84 \uBB34\uB2AC\uB97C
      \uB530\uB77C\uAC00\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 7262043247714308
    m_Localized: "\uAC19\uC740 \uBB34\uB2AC\uC5D0\uC11C\uB294 A\uAC00 \uAC00\uC7A5
      \uAC15\uD569\uB2C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 7262043247714309
    m_Localized: "\uBAA8\uB450 \uD074\uB85C\uBC84\uB97C \uB0C8\uC73C\uBBC0\uB85C
      \u2663A\uAC00 \uC774\uACBC\uC2B5\uB2C8\uB2E4.\n\n\uAC19\uC740 \uBB34\uB2AC\uC5D0\uC11C\uB294
      A > K > Q > J > 10 > 9 > \u2026 > 2 \uC21C\uC11C\uB85C \uAC15\uD569\uB2C8\uB2E4.
      \uD2B8\uB9AD\uC744 \uC774\uAE34 \uC0AC\uB78C\uC774 \uB2E4\uC74C \uD2B8\uB9AD\uC758
      \uCCAB \uCE74\uB4DC\uB97C \uB0C5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7262043247714310
    m_Localized: "\uAE30\uB8E8\uB2E4 \xB7 \uC73C\uB738 \uBB34\uB2AC"
    m_Metadata:
      m_Items: []
  - m_Id: 7262043247714311
    m_Localized: "\uAE30\uB8E8\uB2E4\uB294 \uC774\uBC88 \uD310\uC5D0\uC11C \uAC00\uC7A5
      \uAC15\uD55C \uD798\uC744 \uAC00\uC9C0\uB294 \uBB34\uB2AC\uB97C \uC758\uBBF8\uD569\uB2C8\uB2E4.
      \uC774\uBC88 \uD310\uC758 \uAE30\uB8E8\uB2E4\uB294 \uD558\uD2B8\uC785\uB2C8\uB2E4.
      \uAE30\uB8E8\uB2E4 \uC815\uBCF4\uB294 \uC0C1\uB2E8\uC758 \uD310 \uC815\uBCF4\uC5D0\uC11C
      \uD655\uC778\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\n\uC774\uBC88 \uD2B8\uB9AD\uC740
      \u2666K\uB85C \uC2DC\uC791\uD588\uC9C0\uB9CC \uB0B4 \uC190\uC5D0\uB294 \uB2E4\uC774\uC544\uBAAC\uB4DC\uAC00
      \uC5C6\uC2B5\uB2C8\uB2E4. \uCCAB \uCE74\uB4DC\uC758 \uBB34\uB2AC\uAC00 \uC5C6\uC73C\uBA74
      \uB2E4\uB978 \uBB34\uB2AC\uB97C \uB0BC \uC218 \uC788\uC2B5\uB2C8\uB2E4. \u26654\uB97C
      \uB0B4\uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 7262043247714312
    m_Localized: "\uB2E4\uC774\uC544\uBAAC\uB4DC\uAC00 \uC5C6\uC73C\uBBC0\uB85C \uAE30\uB8E8\uB2E4
      \u26654\uB97C \uB0B4\uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 7262043247714313
    m_Localized: "\u26654\uAC00 \u2666K\uB97C \uC55E\uC130\uC2B5\uB2C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 7262043247714314
    m_Localized: "\u26654\uB294 \u2666K\uBCF4\uB2E4 \uC22B\uC790\uB294 \uB0AE\uC9C0\uB9CC,
      \uD558\uD2B8\uAC00 \uAE30\uB8E8\uB2E4\uC774\uBBC0\uB85C \uB354 \uAC15\uD569\uB2C8\uB2E4.
      \uB178\uB780\uC0C9 \uD14C\uB450\uB9AC\uB3C4 \u26654\uB85C \uC62E\uACA8\uC84C\uC2B5\uB2C8\uB2E4.\n\n\uC544\uC9C1
      \uD55C \uC0AC\uB78C\uC774 \uCE74\uB4DC\uB97C \uB0B4\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4.
      \uD655\uC778\uC744 \uB20C\uB7EC \uB9C8\uC9C0\uB9C9 \uCE74\uB4DC\uB97C \uD655\uC778\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 7262043247714315
    m_Localized: "\uB354 \uB192\uC740 \uAE30\uB8E8\uB2E4\uAC00 \uC774\uAE41\uB2C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 7262043247714316
    m_Localized: "\uB9C8\uC9C0\uB9C9 \uBD07\uC774 \u26656\uC744 \uB0C8\uC2B5\uB2C8\uB2E4.
      \uAC19\uC740 \uAE30\uB8E8\uB2E4\uB07C\uB9AC\uB294 \uC22B\uC790\uAC00 \uB192\uC740
      \uCE74\uB4DC\uAC00 \uAC15\uD558\uBBC0\uB85C \u26656\uC774 \uC774\uACBC\uC2B5\uB2C8\uB2E4.\n\n\uC774
      \uBD07\uC774 \uB2E4\uC74C \uD2B8\uB9AD\uC744 \uC2DC\uC791\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7262043247714317
    m_Localized: "\uB9C8\uC774\uD2F0\uC640 \uC870\uCEE4"
    m_Metadata:
      m_Items: []
  - m_Id: 7262043247714318
    m_Localized: "\uB9C8\uC774\uD2F0\uB294 \uC5B8\uC81C\uB098 \uAC00\uC7A5 \uAC15\uD55C
      \uCE74\uB4DC\uC785\uB2C8\uB2E4. \uBCF4\uD1B5 \u2660A\uC774\uBA70, \uC2A4\uD398\uC774\uB4DC\uAC00
      \uAE30\uB8E8\uB2E4\uC774\uBA74 \u2666A\uAC00 \uB429\uB2C8\uB2E4.\n\n\uC870\uCEE4\uB294
      \uBCF4\uD1B5 \uB9C8\uC774\uD2F0 \uB2E4\uC74C\uC73C\uB85C \uAC15\uD569\uB2C8\uB2E4.
      \uB9C8\uC774\uD2F0\uC640 \uC870\uCEE4\uB294 \uCCAB \uCE74\uB4DC\uC758 \uBB34\uB2AC\uB97C
      \uB530\uB974\uC9C0 \uC54A\uC544\uB3C4 \uB429\uB2C8\uB2E4.\n\n\uC774\uBC88 \uD310\uC740
      \uD558\uD2B8 \uAE30\uB8E8\uB2E4\uC774\uBBC0\uB85C \u2660A\uAC00 \uB9C8\uC774\uD2F0\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7262043247714319
    m_Localized: "\uB9C8\uC774\uD2F0\uB97C \uB0B4\uBCF4\uC138\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 7262043247714320
    m_Localized: "\uBD07\uC774 \uD074\uB85C\uBC84\uB85C \uC2DC\uC791\uD588\uC2B5\uB2C8\uB2E4.
      \uD074\uB85C\uBC84\uAC00 \uC190\uC5D0 \uC788\uC5B4\uB3C4 \uB9C8\uC774\uD2F0\uB294
      \uC608\uC678\uB85C \uB0BC \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\n\u2660A\uB97C
      \uB0B4\uC11C \uAC00\uC7A5 \uAC15\uD55C \uCE74\uB4DC\uC758 \uD798\uC744 \uD655\uC778\uD574
      \uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 7262043247714321
    m_Localized: "\uC774\uBC88 \uD310\uC758 \uB9C8\uC774\uD2F0 \u2660A\uB97C \uB0B4\uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 7262043247714322
    m_Localized: "\uD504\uB80C\uB4DC \uACF5\uAC1C \xB7 \uB9C8\uC774\uD2F0\uB85C \uD300\uC744
      \uB3C4\uC654\uC2B5\uB2C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 7262043247714323
    m_Localized: "\uB9C8\uC9C0\uB9C9 \uBD07\uC774 \u2660A, \uB9C8\uC774\uD2F0\uB97C
      \uB0C8\uC2B5\uB2C8\uB2E4! \uB9C8\uC774\uD2F0\uAC00 \u2665K\uB97C \uC774\uAE30\uACE0
      \uC810\uC218 \uCE74\uB4DC 3\uC7A5\uC744 \uAC00\uC838\uC654\uC2B5\uB2C8\uB2E4.\n\n\uB9C8\uC774\uD2F0
      \uD504\uB80C\uB4DC\uB85C \uC9C0\uC815\uD588\uB358 \uBC14\uB85C \uADF8 \uBD07\uC785\uB2C8\uB2E4.
      \u2660A\uB97C \uB0B4\uBA74\uC11C \uC815\uCCB4\uAC00 \uACF5\uAC1C\uB418\uACE0
      \uBCF4\uB77C\uC0C9 \uD504\uB80C\uB4DC \uB9C8\uD06C\uAC00 \uD45C\uC2DC\uB429\uB2C8\uB2E4.
      \uD504\uB80C\uB4DC\uAC00 \uC5BB\uC740 \uC810\uC218\uB294 \uC8FC\uACF5\uD300
      \uC810\uC218\uB85C \uD569\uC0B0\uB429\uB2C8\uB2E4.\n\n\uC774\uCC98\uB7FC \uD504\uB80C\uB4DC\uB294
      \uC815\uCCB4\uB97C \uC228\uAE34 \uCC44 \uC8FC\uACF5\uC744 \uB3D5\uC2B5\uB2C8\uB2E4.
      \uC774\uC81C \uCD94\uAC00\uB85C 3\uD2B8\uB9AD\uC744 \uC9C1\uC811 \uD310\uB2E8\uD574\uC11C
      \uD50C\uB808\uC774\uD574 \uBD05\uC2DC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7262043247714324
    m_Localized: "A\xB7K\xB7Q\xB7J\xB710\uC740 \uC810\uC218 \uCE74\uB4DC\uC785\uB2C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 7262043247714325
    m_Localized: "\uBC14\uB2E5\uC758 \uCE74\uB4DC 5\uC7A5\uC744 \uC0B4\uD3B4\uBCF4\uC138\uC694.
      A\xB7K\xB7Q\xB7J\xB710\uC740 \uAC01\uAC01 1\uC810\uC785\uB2C8\uB2E4. \uB530\uB77C\uC11C,
      \uD55C \uD310\uC758 \uC804\uCCB4 \uC810\uC218\uB294 20\uC810\uC785\uB2C8\uB2E4.\n\n\uC774\uBC88\uC5D0\uB294
      \u2660A\xB7\u2663K\xB7\u2663Q\xB7\u2663J\uB85C 4\uC810\uC744 \uC5BB\uC5C8\uC2B5\uB2C8\uB2E4.\n\n\uD655\uC778\uC744
      \uB204\uB974\uBA74 \uC810\uC218 \uCE74\uB4DC\uAC00 \uB0B4 \uCABD\uC73C\uB85C
      \uC774\uB3D9\uD558\uACE0 \uB098\uBA38\uC9C0 \uCE74\uB4DC\uB294 \uC815\uB9AC\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7262043247714326
    m_Localized: "\uB0B4\uAC00 \uC120\uC774\uBA74 \uC870\uCEE4\uCF5C!"
    m_Metadata:
      m_Items: []
  - m_Id: 7262043247714327
    m_Localized: "\uC55E \uD2B8\uB9AD\uC744 \uC774\uACBC\uC73C\uBBC0\uB85C \uC774\uBC88\uC5D0\uB294
      \uB0B4\uAC00 \uBA3C\uC800 \uB0C5\uB2C8\uB2E4. \uC774\uBC88 \uD310\uC758 \uC870\uCEE4\uCF5C
      \uCE74\uB4DC\uB294 \u26633\uC785\uB2C8\uB2E4.\n\n\uC870\uCEE4\uB294 \uB9C8\uC774\uD2F0
      \uB2E4\uC74C\uC73C\uB85C \uAC15\uD55C \uCE74\uB4DC\uC774\uC9C0\uB9CC \uC870\uCEE4\uCF5C\uB85C
      \uB04C\uC5B4\uB0B4\uC9C4 \uC870\uCEE4\uB294 \uD798\uC744 \uC783\uC2B5\uB2C8\uB2E4.
      \uC120\uC5D0\uC11C \uC870\uCEE4\uCF5C\uC744 \uC0AC\uC6A9\uD558\uBA74 \uC870\uCEE4\uB97C
      \uAC00\uC9C4 \uC0C1\uB300\uAC00 \uBC18\uB4DC\uC2DC \uC870\uCEE4\uB97C \uB0B4\uC57C
      \uD569\uB2C8\uB2E4.\n\n\u26633\uC744 \uC120\uD0DD\uD55C \uB4A4 \u300C\uC870\uCEE4\uCF5C
      \uC0AC\uC6A9\u300D\uC744 \uB204\uB974\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 7262043247714328
    m_Localized: "\u26633 \u2192 \u300C\uC870\uCEE4\uCF5C \uC0AC\uC6A9\u300D"
    m_Metadata:
      m_Items: []
  - m_Id: 7262043247714329
    m_Localized: "\uC870\uCEE4\uB97C \uB04C\uC5B4\uB0C8\uC2B5\uB2C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 7262043247714330
    m_Localized: "\uC870\uCEE4\uCF5C\uC5D0 \uB04C\uB824 \uB098\uC628 \uC870\uCEE4\uB294
      \uD798\uC744 \uC783\uC5C8\uC2B5\uB2C8\uB2E4. \uC774\uBC88 \uD2B8\uB9AD\uC740
      \uAC00\uC7A5 \uB192\uC740 \uD074\uB85C\uBC84\uC778 \u266310\uC774 \uC774\uACBC\uC2B5\uB2C8\uB2E4.\n\n\uC870\uCEE4\uB294
      \uCCAB \uBC88\uC9F8 \uD2B8\uB9AD\uACFC \uB9C8\uC9C0\uB9C9 \uD2B8\uB9AD\uC5D0\uC11C\uB3C4
      \uD798\uC744 \uC783\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7262043247714331
    m_Localized: "\uCCAB \uBC88\uC9F8 \uC5F0\uC2B5 \uC815\uB9AC"
    m_Metadata:
      m_Items: []
  - m_Id: 7262043247714332
    m_Localized: "\uAE30\uBCF8 \uC138\uAE30: \uB9C8\uC774\uD2F0 > \uC870\uCEE4 >
      \uAE30\uB8E8\uB2E4 > \uCCAB \uCE74\uB4DC\uC758 \uBB34\uB2AC\n\uAC19\uC740 \uBB34\uB2AC:
      A > K > Q > J > 10 > \u2026 > 2\n\n\uC77C\uBC18 \uCE74\uB4DC\uB294 \uCCAB \uBB34\uB2AC\uB97C
      \uB530\uB77C \uB0B4\uACE0, \uB9C8\uC774\uD2F0\uC640 \uC870\uCEE4\uB294 \uC608\uC678\uC785\uB2C8\uB2E4.
      \uC870\uCEE4\uB294 \uCCAB\xB7\uB9C8\uC9C0\uB9C9 \uD2B8\uB9AD\uACFC \uC870\uCEE4\uCF5C\uC5D0\uC11C
      \uD798\uC744 \uC783\uC2B5\uB2C8\uB2E4.\n\nA\xB7K\xB7Q\xB7J\xB710\uC744 \uBAA8\uC544
      \uC810\uC218\uB97C \uC5BB\uC2B5\uB2C8\uB2E4. \uC774\uC81C \uB450 \uBC88\uC9F8
      \uC5F0\uC2B5\uC73C\uB85C \uB118\uC5B4\uAC11\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7262043247714333
    m_Localized: "2 / 2 \xB7 \uACF5\uC57D\uD558\uACE0 \uC8FC\uACF5 \uB418\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 7262043247714334
    m_Localized: "\uAC8C\uC784 \uC2DC\uC791 \uC804\uC5D0\uB294 \uAE30\uB8E8\uB2E4\uC640
      \uBAA9\uD45C \uC810\uC218\uB97C \uC81C\uC2DC\uD574 \uC8FC\uACF5 \uC790\uB9AC\uB97C
      \uB450\uACE0 \uACBD\uC7C1\uD569\uB2C8\uB2E4. \uC774\uAC83\uC744 \uACF5\uC57D\uC774\uB77C\uACE0
      \uD569\uB2C8\uB2E4.\n\n\uC774\uBC88\uC5D0\uB294 \uD558\uD2B8\uAC00 \uB9CE\uC740
      \uAC15\uD55C \uC190\uD328\uC785\uB2C8\uB2E4. 13\uC810\uACFC \u2665\uD558\uD2B8\uB97C
      \uC120\uD0DD\uD558\uACE0 \uACF5\uC57D\uC744 \uC81C\uCD9C\uD558\uC138\uC694.
      \uBD07\uB4E4\uC740 \uBAA8\uB450 \uD328\uC2A4\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7262043247714335
    m_Localized: "13\uC810 \xB7 \u2665\uD558\uD2B8 \uAE30\uB8E8\uB2E4\uB85C \uACF5\uC57D\uC744
      \uC81C\uCD9C\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 7262043247714336
    m_Localized: "\uB2F9\uC2E0\uC774 \uC8FC\uACF5\uC774 \uB418\uC5C8\uC2B5\uB2C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 7262043247714337
    m_Localized: "\uB2E4\uB978 \uBD07\uB4E4\uC774 \uBAA8\uB450 \uD328\uC2A4\uD558\uC5EC
      \uB2F9\uC2E0\uC774 \uC8FC\uACF5\uC73C\uB85C \uD655\uC815\uB418\uC5C8\uC2B5\uB2C8\uB2E4.\n\n\uC774\uBC88
      \uD310\uC758 \uBAA9\uD45C\uB294 \u2665\uD558\uD2B8\uB97C \uAE30\uB8E8\uB2E4\uB85C
      \uD558\uACE0 \uC6B0\uB9AC \uD300\uC774 13\uC810 \uC774\uC0C1 \uC5BB\uB294 \uAC83\uC785\uB2C8\uB2E4.
      \uD655\uC778\uC744 \uB204\uB974\uBA74 \uBC14\uB2E5\uD328 3\uC7A5\uC744 \uAC00\uC838\uC635\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7262043247714338
    m_Localized: "\uBC14\uB2E5\uD328 3\uC7A5 \uAD50\uD658"
    m_Metadata:
      m_Items: []
  - m_Id: 7262043247714339
    m_Localized: "\uBC14\uB2E5\uD328 3\uC7A5\uC744 \uBC1B\uC544 \uC190\uD328\uAC00
      13\uC7A5\uC774 \uB418\uC5C8\uC2B5\uB2C8\uB2E4. 3\uC7A5\uC744 \uBC84\uB824 \uB2E4\uC2DC
      10\uC7A5\uC73C\uB85C \uB9CC\uB4E4\uC5B4\uC57C \uD569\uB2C8\uB2E4.\n\n\u26602\xB7\u26662\xB7\u26632\uB97C
      \uC120\uD0DD\uD558\uACE0 \u300C3\uC7A5 \uBC84\uB9AC\uAE30\u300D\uB97C \uB204\uB974\uC138\uC694.
      \uB2E4\uC2DC \uB204\uB974\uBA74 \uC120\uD0DD\uC774 \uD574\uC81C\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7262043247714340
    m_Localized: "\u26602\xB7\u26662\xB7\u26632\uB97C \uC120\uD0DD\uD55C \uB4A4 \u300C3\uC7A5
      \uBC84\uB9AC\uAE30\u300D"
    m_Metadata:
      m_Items: []
  - m_Id: 7262043247714341
    m_Localized: "\uC190\uD328\uB97C \uC815\uB9AC\uD588\uC2B5\uB2C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 7262043247714342
    m_Localized: "3\uC7A5\uC744 \uBC84\uB824 \uC190\uD328\uAC00 \uB2E4\uC2DC 10\uC7A5\uC774
      \uB418\uC5C8\uC2B5\uB2C8\uB2E4. \uC8FC\uACF5\uC740 \uBC14\uB2E5\uD328\uB97C
      \uC774\uC6A9\uD574 \uC790\uC2E0\uC758 \uD328\uB97C \uC815\uB9AC\uD560 \uC218
      \uC788\uC2B5\uB2C8\uB2E4.\n\n\uBC84\uB9B0 \uC810\uC218 \uCE74\uB4DC\uB294 \uC8FC\uACF5\uD300
      \uC810\uC218\uC5D0 \uD3EC\uD568\uB429\uB2C8\uB2E4. \uC774\uBC88\uC5D0 \uBC84\uB9B0
      \uC138 \uC7A5\uC740 \uC810\uC218 \uCE74\uB4DC\uAC00 \uC544\uB2D9\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7262043247714343
    m_Localized: "\uD568\uAED8\uD560 \uD504\uB80C\uB4DC \uC120\uC5B8"
    m_Metadata:
      m_Items: []
  - m_Id: 7262043247714344
    m_Localized: "\uC8FC\uACF5\uC740 \uD2B9\uC815 \uCE74\uB4DC\uB97C \uAC00\uC9C4
      \uC0AC\uB78C\uC744 \uD504\uB80C\uB4DC\uB85C \uC9C0\uC815\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\n\uC774\uBC88\uC5D0\uB294
      \uB0B4\uAC00 \uAC00\uC9C0\uC9C0 \uC54A\uC740 \uB9C8\uC774\uD2F0\uC758 \uC8FC\uC778\uC744
      \uC6B0\uB9AC \uD300\uC73C\uB85C \uBD88\uB7EC\uBD05\uC2DC\uB2E4. \u300C\uB9C8\uC774\uD2F0\u300D\uB97C
      \uB204\uB974\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 7262043247714345
    m_Localized: "\u300C\uB9C8\uC774\uD2F0\u300D\uB97C \uB20C\uB7EC \uD504\uB80C\uB4DC\uB97C
      \uC120\uC5B8\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 7262043247714346
    m_Localized: "\uB9C8\uC774\uD2F0\uC758 \uC8FC\uC778\uC774 \uAC19\uC740 \uD300\uC785\uB2C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 7262043247714347
    m_Localized: "\u2660A\uB97C \uAC00\uC9C4 \uC0AC\uB78C\uC774 \uB2F9\uC2E0\uC758
      \uD504\uB80C\uB4DC\uAC00 \uB418\uC5C8\uC2B5\uB2C8\uB2E4. \uADF8 \uC0AC\uB78C\uC774
      \u2660A\uB97C \uB0B4\uAE30 \uC804\uAE4C\uC9C0\uB294 \uC8FC\uACF5\uB3C4 \uC815\uCCB4\uB97C
      \uC54C \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.\n\n\uD50C\uB808\uC774\uC5B4 \uC9C0\uC815\uC740
      \uD2B9\uC815 \uC0AC\uB78C\uC744 \uC989\uC2DC \uACF5\uAC1C\uD558\uBA70 \uD504\uB80C\uB4DC\uB85C
      \uC120\uD0DD\uD569\uB2C8\uB2E4. \uB178\uD504\uB80C\uB4DC\uB294 \uD63C\uC790
      \uC8FC\uACF5\uD300\uC73C\uB85C \uB3C4\uC804\uD558\uB294 \uC120\uD0DD\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7262043247714348
    m_Localized: "\uC8FC\uACF5\uC758 \uCCAB \uCE74\uB4DC"
    m_Metadata:
      m_Items: []
  - m_Id: 7262043247714349
    m_Localized: "\uCCAB \uD2B8\uB9AD\uC740 \uC8FC\uACF5\uC774 \uC2DC\uC791\uD569\uB2C8\uB2E4.
      \uC774\uBC88 \uD310\uC758 \uAE30\uB8E8\uB2E4\uB294 \u2665\uD558\uD2B8\uC785\uB2C8\uB2E4.\n\n\uAC00\uC7A5
      \uB192\uC740 \uD558\uD2B8\uC778 \u2665A\uB97C \uB0B4\uC11C \uCCAB \uD2B8\uB9AD\uC744
      \uC2DC\uC791\uD574 \uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 7262043247714350
    m_Localized: "\u2665A\uB97C \uB0B4\uC11C \uCCAB \uD2B8\uB9AD\uC744 \uC2DC\uC791\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 7262043247714351
    m_Localized: "\u2665A\uB85C \uCCAB \uD2B8\uB9AD\uC744 \uC774\uACBC\uC2B5\uB2C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 7262043247714352
    m_Localized: "\uBAA8\uB450 \uD558\uD2B8\uB97C \uB0C8\uC73C\uBBC0\uB85C \uAC00\uC7A5
      \uB192\uC740 \u2665A\uAC00 \uC774\uACBC\uC2B5\uB2C8\uB2E4.\n\n\uC190\uC5D0\uB294
      \u2665Q\xB7\u2665J\xB7\u266510 \uB4F1 \uAC15\uD55C \uAE30\uB8E8\uB2E4\uAC00
      \uB0A8\uC544 \uC788\uC9C0\uB9CC \u2665K\uB294 \uC5C6\uC2B5\uB2C8\uB2E4. \uD504\uB80C\uB4DC\uAC00
      \uB204\uAD6C\uC778\uC9C0\uB3C4 \uC544\uC9C1 \uBAA8\uB985\uB2C8\uB2E4. \uB2E4\uC74C
      \uD2B8\uB9AD\uC744 \uC774\uC5B4\uAC00 \uBD05\uC2DC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7262043247714353
    m_Localized: "\uC9C1\uC811 \uD310\uB2E8\uD574\uC11C \uD50C\uB808\uC774\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 7262043247714354
    m_Localized: "\uBC30\uC6B4 \uADDC\uCE59\uC744 \uC774\uC6A9\uD574 \uC6D0\uD558\uB294
      \uCE74\uB4DC\uB97C \uB0B4\uBCF4\uC138\uC694. \uADDC\uCE59\uC0C1 \uAC00\uB2A5\uD55C
      \uCE74\uB4DC\uB77C\uBA74 \uBAA8\uB450 \uC120\uD0DD\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\n\uAC01
      \uD2B8\uB9AD\uC774 \uB05D\uB098\uBA74 \uC2E4\uC81C \uACB0\uACFC\uB97C \uD568\uAED8
      \uD655\uC778\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7262043247714355
    m_Localized: "\uB0BC \uC218 \uC788\uB294 \uCE74\uB4DC \uC911 \uC6D0\uD558\uB294
      \uCE74\uB4DC\uB97C \uC120\uD0DD\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 7262043247714356
    m_Localized: "\uC5F0\uC2B5 \uC644\uB8CC!"
    m_Metadata:
      m_Items: []
  - m_Id: 7262043247714357
    m_Localized: "\uCD95\uD558\uD569\uB2C8\uB2E4! \uBB34\uB2AC \uB530\uB77C\uB0B4\uAE30,
      \uAE30\uB8E8\uB2E4, \uB9C8\uC774\uD2F0\uC640 \uD504\uB80C\uB4DC, \uC810\uC218
      \uCE74\uB4DC, \uC870\uCEE4\uCF5C\uC744 \uC9C1\uC811 \uACBD\uD5D8\uD588\uC2B5\uB2C8\uB2E4.\n\n\uC8FC\uACF5\uC758
      \uACF5\uC57D\xB7\uBC14\uB2E5\uD328 \uAD50\uD658\xB7\uD504\uB80C\uB4DC \uC120\uC5B8\uACFC
      \uC790\uC720 \uD50C\uB808\uC774 3\uD2B8\uB9AD\uB3C4 \uB9C8\uCCE4\uC2B5\uB2C8\uB2E4.\n\n\uC2E4\uC804\uC5D0\uC11C\uB294
      \uD55C \uD310\uC5D0 10\uD2B8\uB9AD\uC744 \uC9C4\uD589\uD569\uB2C8\uB2E4. \uC8FC\uACF5\uD300\uC740
      \uACF5\uC57D\uD55C \uC810\uC218 \uC774\uC0C1\uC744 \uC5BB\uC73C\uBA74 \uC2B9\uB9AC\uD558\uACE0,
      \uC218\uBE44\uD300\uC740 \uC774\uB97C \uB9C9\uC73C\uBA74 \uC2B9\uB9AC\uD569\uB2C8\uB2E4.
      \uC774\uC81C \uC2F1\uAE00\uD50C\uB808\uC774\uC5D0\uC11C \uC790\uC720\uB86D\uAC8C
      \uC5F0\uC2B5\uD574 \uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 7262043247714358
    m_Localized: "\uC2F1\uAE00\uD50C\uB808\uC774 \uC2DC\uC791"
    m_Metadata:
      m_Items: []
  - m_Id: 7262043247714359
    m_Localized: "\uB9C8\uC774\uD2F0 \uD29C\uD1A0\uB9AC\uC5BC"
    m_Metadata:
      m_Items: []
  - m_Id: 7262043247714360
    m_Localized: "\uB9C8\uC774\uD2F0\uB294 5\uBA85\uC774 \uB450 \uD300\uC73C\uB85C
      \uB098\uB258\uC5B4 \uC810\uC218 \uCE74\uB4DC\uB97C \uBAA8\uC73C\uB294 \uAC8C\uC784\uC785\uB2C8\uB2E4.\n\n\uD55C
      \uC0AC\uB78C\uC529 \uCE74\uB4DC 1\uC7A5\uC744 \uB0B4\uACE0, \uAC00\uC7A5 \uAC15\uD55C
      \uCE74\uB4DC\uB97C \uB0B8 \uC0AC\uB78C\uC774 \uBC14\uB2E5\uC758 \uCE74\uB4DC
      5\uC7A5\uC744 \uAC00\uC838\uAC11\uB2C8\uB2E4. \uC774 \uD55C \uBC88\uC758 \uC9C4\uD589\uC744
      \uD2B8\uB9AD\uC774\uB77C\uACE0 \uD569\uB2C8\uB2E4.\n\n\uB450 \uBC88\uC758 \uC9E7\uC740
      \uC5F0\uC2B5 \uAC8C\uC784\uC744 \uC9C1\uC811 \uD50C\uB808\uC774\uD558\uBA74\uC11C
      \uADDC\uCE59\uC744 \uC775\uD600 \uBD05\uC2DC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7262043247714361
    m_Localized: "\uD2B8\uB9AD \uACB0\uACFC"
    m_Metadata:
      m_Items: []
  - m_Id: 7262043247714362
    m_Localized: "\uB9C8\uC774\uD2F0\uAC00 \uB098\uC640 \uB2E4\uB978 \uCE74\uB4DC\uBCF4\uB2E4
      \uAC15\uD588\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7262043247714363
    m_Localized: "\uC774\uBC88 \uD2B8\uB9AD\uC5D0\uC11C\uB294 \uC870\uCEE4\uC758
      \uD798\uC774 \uC720\uD6A8\uD558\uC5EC \uC870\uCEE4\uAC00 \uC774\uACBC\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7262043247714364
    m_Localized: "\uAE30\uB8E8\uB2E4\uAC00 \uCCAB \uCE74\uB4DC\uC758 \uBB34\uB2AC\uBCF4\uB2E4
      \uAC15\uD574 \uC774\uACBC\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7262043247714365
    m_Localized: "\uAC19\uC740 \uBB34\uB2AC \uC911 \uAC00\uC7A5 \uB192\uC740 \uCE74\uB4DC\uAC00
      \uC774\uACBC\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7262043247714366
    m_Localized: "\uADDC\uCE59\uC5D0 \uB9DE\uB294 \uCE74\uB4DC\uB97C \uC9C1\uC811
      \uC120\uD0DD\uD588\uC2B5\uB2C8\uB2E4. \uD2B8\uB9AD\uC744 \uC774\uAE34 \uC0AC\uB78C\uC774
      \uB2E4\uC74C \uD2B8\uB9AD\uC744 \uC2DC\uC791\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7262043247714367
    m_Localized: "\uB9C8\uC774\uD2F0\uB294 \uBB34\uB2AC\uB97C \uB530\uB974\uC9C0
      \uC54A\uC544\uB3C4 \uB429\uB2C8\uB2E4. \uC9C0\uAE08\uC740 \uC77C\uBC18 \uCE74\uB4DC\uC758
      \uBB34\uB2AC \uB530\uB77C\uB0B4\uAE30\uB97C \uC5F0\uC2B5\uD558\uBBC0\uB85C
      \u26632\uB97C \uB0B4\uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 7262043247714368
    m_Localized: "\u26633\uB3C4 \uB0BC \uC218 \uC788\uC9C0\uB9CC \uB4A4\uC758 \uC870\uCEE4\uCF5C
      \uC5F0\uC2B5\uC5D0 \uB0A8\uACA8\uB461\uB2C8\uB2E4. \uC774\uBC88\uC5D0\uB294
      \u26632\uB97C \uB0B4\uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 7262043247714369
    m_Localized: "\uCCAB \uCE74\uB4DC\uAC00 \uD074\uB85C\uBC84\uC785\uB2C8\uB2E4.
      \uC190\uC5D0 \uD074\uB85C\uBC84\uAC00 \uC788\uC73C\uBBC0\uB85C \uC77C\uBC18
      \uCE74\uB4DC\uB294 \uD074\uB85C\uBC84\uB97C \uB0B4\uC57C \uD569\uB2C8\uB2E4.
      \u26632\uB97C \uB0B4\uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 7262043247714370
    m_Localized: "\uC774\uBC88\uC5D0\uB294 \uAE30\uB8E8\uB2E4\uC758 \uD798\uC744
      \uD655\uC778\uD569\uB2C8\uB2E4. \uB2E4\uC774\uC544\uBAAC\uB4DC\uAC00 \uC5C6\uC73C\uBBC0\uB85C
      \u26654\uB97C \uB0BC \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7262043247714371
    m_Localized: "\uC774\uBC88\uC5D0\uB294 \uAC00\uC7A5 \uAC15\uD55C \uCE74\uB4DC\uC778
      \uB9C8\uC774\uD2F0\uB97C \uC5F0\uC2B5\uD569\uB2C8\uB2E4. \u2660A\uB97C \uB0B4\uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 7262043247714372
    m_Localized: "\uC774\uBC88\uC5D0\uB294 \uC870\uCEE4\uCF5C\uC744 \uC5F0\uC2B5\uD569\uB2C8\uB2E4.
      \u26633\uC744 \uC120\uD0DD\uD558\uACE0 \u300C\uC870\uCEE4\uCF5C \uC0AC\uC6A9\u300D\uC744
      \uB20C\uB7EC\uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 7262043247714373
    m_Localized: "\uD558\uD2B8\uAC00 \uB9CE\uC740 \uD328\uB85C \uC8FC\uACF5\uC774
      \uB418\uB294 \uC5F0\uC2B5\uC785\uB2C8\uB2E4. 13\uC810 \xB7 \uD558\uD2B8 \uAE30\uB8E8\uB2E4\uB85C
      \uACF5\uC57D\uC744 \uC81C\uCD9C\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 7262043247714374
    m_Localized: "\uC190\uD328\uB97C 10\uC7A5\uC73C\uB85C \uB9CC\uB4E4\uAE30 \uC704\uD574
      3\uC7A5\uC744 \uBC84\uB824\uC57C \uD569\uB2C8\uB2E4. \uC774\uBC88\uC5D0\uB294
      \u26602\xB7\u26662\xB7\u26632\uB97C \uC120\uD0DD\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 7262043247714375
    m_Localized: "\uC774\uBC88 \uC5F0\uC2B5\uC5D0\uC11C\uB294 \uB9C8\uC774\uD2F0\uB97C
      \uAC00\uC9C4 \uC0AC\uB78C\uC744 \uD504\uB80C\uB4DC\uB85C \uC9C0\uC815\uD569\uB2C8\uB2E4.
      \u300C\uB9C8\uC774\uD2F0\u300D\uB97C \uC120\uD0DD\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 7262043247714376
    m_Localized: "\uC8FC\uACF5\uC740 \uCCAB \uD2B8\uB9AD\uC744 \uC2DC\uC791\uD569\uB2C8\uB2E4.
      \uC774\uBC88\uC5D0\uB294 \uAC00\uC7A5 \uB192\uC740 \uD558\uD2B8\uC778 \u2665A\uB97C
      \uB0B4\uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 7262043247714377
    m_Localized: "\uD604\uC7AC \uC548\uB0B4\uC5D0 \uB530\uB77C \uC9C4\uD589\uD574
      \uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 7262043247714378
    m_Localized: "\uCCAB \uCE74\uB4DC\uC640 \uAC19\uC740 \uBB34\uB2AC\uB97C \uAC00\uC9C0\uACE0
      \uC788\uC73C\uBBC0\uB85C \uB2E4\uB978 \uC77C\uBC18 \uBB34\uB2AC\uB294 \uB0BC
      \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7262043247714379
    m_Localized: "\uC870\uCEE4\uCF5C\uC774 \uD65C\uC131\uD654\uB418\uC5B4 \uC870\uCEE4\uB97C
      \uB0B4\uC57C \uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7262043247714380
    m_Localized: "\uC790\uC720 \uD50C\uB808\uC774 1 / 3"
    m_Metadata:
      m_Items: []
  - m_Id: 7262043247714381
    m_Localized: "\uC790\uC720 \uD50C\uB808\uC774 2 / 3"
    m_Metadata:
      m_Items: []
  - m_Id: 7262043247714382
    m_Localized: "\uC790\uC720 \uD50C\uB808\uC774 3 / 3"
    m_Metadata:
      m_Items: []
  - m_Id: 7262043247714383
    m_Localized: "\uB2F9\uC2E0\uC774 \uC774\uBC88 \uD2B8\uB9AD\uC744 \uC774\uACA8
      \uC810\uC218 \uCE74\uB4DC 0\uC7A5\uC744 \uAC00\uC838\uAC14\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7262043247714384
