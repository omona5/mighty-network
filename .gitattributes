# 기본: 텍스트 파일은 git이 줄바꿈을 자동 정규화(저장은 LF)
* text=auto eol=lf

# 스크립트/코드
*.js   text eol=lf
*.cs   text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.html text eol=lf
*.css  text eol=lf

# 바이너리로 취급 (줄바꿈 변환 금지)
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.psd  binary
*.aseprite binary
*.wav  binary
*.mp3  binary
*.ogg  binary
*.unity   binary
*.prefab  binary
*.asset   binary
